      AND TABLE_NAME IN ('STAGING', 'STAGING_FOLDERS')
      AND COLUMN_NAME IN ('ID', 'staging_id', 'Is_Processed', 'folderID')
    ORDER BY TABLE_NAME, COLUMN_NAME
""")
