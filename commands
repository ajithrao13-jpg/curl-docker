sql-unit-tests:
  stage: test
  image: <your-custom-python-image-from-jfrog>
  services:
    - name: <your-sql-server-image-from-jfrog>
      alias: sqlserver
      variables:
        ACCEPT_EULA: "Y"
        MSSQL_SA_PASSWORD: "Str0ngPass!2024"
  script:
    - python3.12 tests/setup_db.py
    - pytest tests/ --tb=short --junitxml=test-results.xml --html=test-report.html --self-contained-html
  artifacts:
    when: always
    reports:
      junit: test-results.xml
    paths:
      - test-results.xml
      - test-report.html
    expire_in: 30 days
