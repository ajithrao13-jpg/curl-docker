-- @@TEST: TC04 - Duplicate staging rows are deduplicated
-- @@DESCRIPTION: 3 identical rows → 1 TARGET insert, rows_deduped=2

INSERT INTO dbo.STAGING (ID) VALUES (1);
INSERT INTO dbo.STAGING_FOLDERS (Staging_ID, Folder_Name, Is_Processed)
VALUES (1,'FOLDER-A','N'),(1,'FOLDER-A','N'),(1,'FOLDER-A','N');

EXEC dbo.USP_DELTA_FOLDERS;

-- @@ASSERT: TARGET_FOLDERS should have exactly 1 row
SELECT CASE WHEN COUNT(*) = 1 THEN 1 ELSE 0 END FROM dbo.TARGET_FOLDERS;

-- @@ASSERT: rows_deduped should be 2
SELECT CASE WHEN rows_deduped = 2 THEN 1 ELSE 0 END
FROM dbo.SYS_DELTA_LOG ORDER BY log_id DESC OFFSET 0 ROWS FETCH NEXT 1 ROW ONLY;

-- @@END_TEST
