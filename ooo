FROM artifactory-saas.mtb.com/mtb-docker-ga/mtb-ubi8-python311:0.1.99

# — Microsoft ODBC Driver 18 via MTB Artifactory mirror —
ARG ARTIFACTORY_TOKEN
RUN printf '%s\n' \
    '[mssql-release]' \
    'name=MSSQL Release (MTB Artifactory mirror)' \
    'baseurl=https://artifactory-saas.mtb.com/artifactory/rpm-packagesmicrosoftcomrhel-remote/8/prod/' \
    'enabled=1' \
    'gpgcheck=0' \
    "username=$(whoami)" \
    "password=${ARTIFACTORY_TOKEN}" \
    > /etc/yum.repos.d/mssql-release.repo \
 && ACCEPT_EULA=Y dnf install -y msodbcsql18 unixODBC-devel \
 && dnf clean all \
 && rm -f /etc/yum.repos.d/mssql-release.repo

# — Python dependencies —
WORKDIR /app
COPY requirements.txt requirements-web.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-web.txt

# — Application code —
COPY . .

EXPOSE 5000
CMD ["python", "webapp/app.py"]
