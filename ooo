FROM artifactory-saas.mtb.com/mtb-docker-ga/mtb-ubi8-python311:0.1.99

ARG ARTIFACTORY_USER
ARG ARTIFACTORY_TOKEN

# — Microsoft ODBC Driver 18 via MTB Artifactory mirror —
RUN printf '%s\n' \
    '[Artifactory]' \
    'name=Artifactory' \
    "baseurl=https://${ARTIFACTORY_USER}:${ARTIFACTORY_TOKEN}@artifactory-saas.mtb.com/artifactory/rpm-packagesmicrosoftcomrhel-remote/8/prod/" \
    'enabled=1' \
    'gpgcheck=0' \
    > /etc/yum.repos.d/artifactory.repo \
 && ACCEPT_EULA=Y dnf install -y msodbcsql18 unixODBC-devel \
 && dnf clean all \
 && rm -f /etc/yum.repos.d/artifactory.repo

# — Python dependencies —
WORKDIR /app
COPY requirements.txt requirements-web.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-web.txt

# — Application code —
COPY . .

EXPOSE 5000
CMD ["python", "webapp/app.py"]




